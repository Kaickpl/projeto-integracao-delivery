DATABASE_URL=postgresql+psycopg://USUARIO:SENHA_CODIFICADA@HOST:5432/BANCO?sslmode=require
# Mesmo valor de autenticacao/.env: PERFIS_STATUS_SERVICE_TOKEN.
INTERNAL_SERVICE_TOKEN=SEGREDO_AUTH_PERFIS_STATUS
AUTENTICACAO_URL=http://autenticacao:8001
# Mesmo valor de autenticacao/.env: PERFIS_SERVICE_TOKEN.
AUTENTICACAO_SERVICE_TOKEN=SEGREDO_PERFIS_AUTH_CREDENCIAIS
AUTORIZACAO_URL=http://autorizacao:8003
# Mesmo valor de autorizacao/.env: INTERNAL_SERVICE_TOKEN.
AUTORIZACAO_SERVICE_TOKEN=SEGREDO_PERFIS_RBAC
# Validação local dos tokens M2M destinados a esta API.
PERFIS_OAUTH_AUDIENCE=http://perfis:8002
PERFIS_READ_SCOPE=perfis:ler
AUTHENTICACAO_ISSUER=http://localhost:8001
