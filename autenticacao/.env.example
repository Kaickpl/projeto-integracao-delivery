DATABASE_URL=postgresql+psycopg://USUARIO:SENHA_CODIFICADA@HOST:5432/BANCO?sslmode=require

JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_OLD_PUBLIC_KEYS_DIR=./keys/anteriores
JWT_KEY_ID=identidade-dev-1
JWT_ISSUER=http://localhost:8001
JWT_ACCESS_TOKEN_MINUTES=25
PERFIS_URL=http://perfis:8002

# Mesmo valor de perfis/.env: INTERNAL_SERVICE_TOKEN.
PERFIS_STATUS_SERVICE_TOKEN=SEGREDO_AUTH_PERFIS_STATUS
# Mesmo valor de perfis/.env: AUTENTICACAO_SERVICE_TOKEN.
PERFIS_SERVICE_TOKEN=SEGREDO_PERFIS_AUTH_CREDENCIAIS
AUTORIZACAO_URL=http://autorizacao:8003
# Mesmo valor de autorizacao/.env: AUTHENTICACAO_SERVICE_TOKEN.
AUTORIZACAO_SERVICE_TOKEN=SEGREDO_AUTH_RBAC
INTEGRATION_TIMEOUT_SECONDS=2
OAUTH_CLIENT_ID=delivery-app
OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback
JWT_AUDIENCE=delivery-api
OAUTH_CLIENT_CREDENTIALS_ENABLED=false
OAUTH_SERVICE_TOKEN_MINUTES=10
